# 密码学闯关后端环境变量示例（复制为 .env 并填值）
# MySQL 连接（D-01 冻结：utf8mb4 + Asia/Shanghai）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cryptoquest?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT
CRYPTOQUEST_JWT_SECRET=please-change-to-a-32+chars-random-secret-in-prod
CRYPTOQUEST_JWT_EXPIRATION_MS=86400000

# AI 通道（华为云 MaaS，未配置则降级到本地提示词模板）
CRYPTOQUEST_AI_MAAS_ENDPOINT=
CRYPTOQUEST_AI_MAAS_API_KEY=
CRYPTOQUEST_AI_MAAS_MODEL=pangu-gpt-35-8k
CRYPTOQUEST_AI_FALLBACK_ENABLED=false

# 演示 admin 引导（留空则不 seed admin；生产请关闭或改强密码）
CRYPTOQUEST_ADMIN_BOOTSTRAP_PASSWORD=admin123456